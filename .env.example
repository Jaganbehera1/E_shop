# Copy this file to .env and fill in your Supabase project credentials.
# Find them at: https://supabase.com → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Razorpay live/test key (leave blank to use COD demo mode)
# VITE_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
